{
  "name": "dehqon-bozori-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:districts": "node ../frontend/scripts/gen-districts.mjs --out src/lib/districts.ts",
    "verify": "node ../frontend/scripts/gen-districts.mjs --out src/lib/districts.ts --check && node scripts/verify.mjs",
    "check": "npm run verify && npm run typecheck && npm run lint && npm run test",
    "bundle": "expo export --platform android --output-dir dist",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview"
  },
  "private": true,
  "description": "Dehqon Bozori — Android/iOS ilova (Expo). Vositachisiz qishloq bozori.",
  "engines": {
    "node": "^20.19.4 || >=22.13.0"
  }
}
