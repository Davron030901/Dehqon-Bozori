{
  "expo": {
    "name": "Dehqon Bozori",
    "slug": "dehqon-bozori",
    "scheme": "dehqonbozori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F1",
    "description": "Dehqondan to'g'ridan-to'g'ri xaridorga — vositachisiz qishloq bozori.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.dehqonbozori.app"
    },
    "android": {
      "package": "uz.dehqonbozori.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D9E75",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F1"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mahsulot rasmini e'longa qo'shish uchun galereyaga ruxsat kerak.",
          "cameraPermission": "Mahsulotni suratga olib e'longa qo'shish uchun kameraga ruxsat kerak.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
