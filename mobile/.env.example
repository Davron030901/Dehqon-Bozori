# Copy to .env.local (gitignored) and adjust.
#
# EXPO_PUBLIC_* values are compiled into the app and visible to anyone who
# unpacks it — never put a secret here.

# The Dehqon Bozori API (the same backend the website and the Telegram bot use).
#   * Expo Go on a real phone: your computer's LAN address, e.g.
#       EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
#     ("localhost" on a phone is the phone itself, not your computer)
#   * Production: the Render URL
# Leave EMPTY to run the app on built-in demo listings.
EXPO_PUBLIC_API_URL=

# The website, used for "share" links so a shared listing opens in any browser.
EXPO_PUBLIC_SITE_URL=https://dehqon-bozori.vercel.app

# The Telegram bot's @username (without @) — for the "open the bot" button.
EXPO_PUBLIC_BOT_USERNAME=DehqonBozoriBot
