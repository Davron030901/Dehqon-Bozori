# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.

# --- Telegram --------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456789:AA-replace-with-your-own-token
# Your bot's @username WITHOUT the @. Required for website login, because the
# site sends people to https://t.me/<BOT_USERNAME>?start=login_<code>
BOT_USERNAME=DehqonBozoriBot

# --- Database --------------------------------------------------------------
# ONE database is shared by the API and the bot. Whatever either writes, the
# other sees immediately.
#
# Local development — SQLite, zero setup:
DATABASE_URL=sqlite+aiosqlite:///dehqon_bozori.db
#
# Production — Supabase Postgres.
# Supabase dashboard → Connect → *** Session pooler *** → copy the URI, then
# change the scheme to postgresql+asyncpg:// and URL-encode any special
# characters in the password (@ -> %40, # -> %23, $ -> %24).
#
#   DATABASE_URL=postgresql+asyncpg://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# IMPORTANT: use the SESSION POOLER, not the "Direct connection".
# The direct host (db.<ref>.supabase.co) is IPv6-only on the free tier and
# Render has no outbound IPv6 — it fails with ENETUNREACH. The pooler is IPv4
# on every tier. Note the username is postgres.<project-ref>, not postgres.
#
# If you ever use the TRANSACTION pooler (port 6543) instead, append:
#   ?prepared_statement_cache_size=0

# --- Web -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Render injects PORT automatically and it overrides API_PORT. Leave unset locally.
# PORT=
# Public address of this service (the API).
PUBLIC_BASE_URL=http://localhost:8000
# Public address of the storefront (Next.js on Vercel). The bot's "open the
# website" button and admin notifications link here. Empty -> PUBLIC_BASE_URL.
SITE_URL=http://localhost:3000
# Optional: where to download the Android app (EAS build link or Play Store).
# The bot shows a download button when this is set.
ANDROID_APP_URL=
# Browser origins allowed to call the API. In production list your Vercel URL:
#   CORS_ORIGINS=https://dehqon-bozori.vercel.app,https://dehqonbozori.uz
CORS_ORIGINS=*
MAX_UPLOAD_MB=8
WEB_PAGE_SIZE=24

# --- Access ----------------------------------------------------------------
# Comma-separated Telegram user IDs allowed to use /stats and the admin panel.
# Message @userinfobot on Telegram to find yours.
ADMIN_IDS=
# Shared secret for the machine-to-machine endpoints (POST /listings,
# POST /sellers, PATCH /listings/{id}/sold). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave EMPTY and those endpoints stay disabled — they fail closed, never open.
ADMIN_API_TOKEN=

# --- Photo durability ------------------------------------------------------
# Render's free disk is wiped on every deploy. Set this to a chat id and every
# website photo upload is mirrored into Telegram, which then stores it
# permanently for free. Use a private channel with the bot as admin (its id
# looks like -1001234567890) or simply your own Telegram user id.
# Leave empty and uploads work but do NOT survive a restart.
PHOTO_ARCHIVE_CHAT_ID=

# --- Marketplace -----------------------------------------------------------
DEFAULT_CURRENCY=so'm
LISTINGS_PER_PAGE=5
ENV=development
