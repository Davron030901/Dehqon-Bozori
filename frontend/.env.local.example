# Copy to .env.local and adjust. Every variable here is safe to expose to the
# browser (NEXT_PUBLIC_*) — never put a service key or secret in this file.

# --- Dehqon Bozori API -----------------------------------------------------
# Base URL of the FastAPI backend (the one the Telegram bot shares a database
# with). Leave EMPTY to run the site entirely on the demo data in
# lib/mockData.ts — useful for design work and for a first Vercel preview
# before the backend is deployed.
#
#   local backend :  http://localhost:8000
#   production    :  https://dehqon-bozori.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telegram bot @username, without the @. Used for the "sign in with Telegram"
# deep link and the "open the bot" links.
NEXT_PUBLIC_BOT_USERNAME=DehqonBozoriBot

# Public address of this site — used for the sitemap, robots.txt and the
# Open Graph links people share in Telegram.
NEXT_PUBLIC_SITE_URL=https://dehqon-bozori.vercel.app

# Optional: where to download the Android app (an EAS build link or the Play
# Store page). A download button appears on the homepage and in the footer.
NEXT_PUBLIC_ANDROID_APP_URL=

# --- Reserved for later ----------------------------------------------------
# If the project ever moves to Supabase instead of the FastAPI backend, these
# are the only two variables the frontend would need. Nothing reads them today.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
